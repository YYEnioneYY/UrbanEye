generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CameraStatus {
  online
  offline
  maintenance
  planned

  @@map("camera_status")
}

enum CameraHealthStatus {
  unknown
  online
  offline
  unstable

  @@map("camera_health_status")
}

model Camera {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  slug        String       @unique
  description String?
  status      CameraStatus @default(planned)

  city        String?
  address     String?
  category    String?

  previewUrl String? @map("preview_url")

  location    Unsupported("geometry(Point, 4326)")

  directionDeg Float? @map("direction_deg")
  fovDeg       Float  @default(90) @map("fov_deg")
  rangeMeters  Int    @default(100) @map("range_meters")

  viewsCount Int @default(0) @map("views_count")

  healthStatus        CameraHealthStatus @default(unknown) @map("health_status")
  videoCodec          String?            @map("video_codec")
  audioCodec          String?            @map("audio_codec")
  transcodingRequired Boolean            @default(false) @map("transcoding_required")
  lastCheckedAt       DateTime?          @map("last_checked_at")
  lastOnlineAt        DateTime?          @map("last_online_at")
  lastOfflineAt       DateTime?          @map("last_offline_at")
  healthError         String?            @map("health_error")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  connection  CameraConnection?

  @@map("cameras")
}

model CameraConnection {
  id                String   @id @default(uuid()) @db.Uuid
  cameraId          String   @unique @map("camera_id") @db.Uuid

  encryptedRtspUrl  String   @map("encrypted_rtsp_url")
  encryptedUsername String?  @map("encrypted_username")
  encryptedPassword String?  @map("encrypted_password")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@map("camera_connections")
}